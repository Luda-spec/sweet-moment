generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
    directUrl = env("PRISMA_DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  
  email    String    @unique
  password String
  role     UserRole  @default(USER)
  
  provider   String?
  providerId String?

  cart   Cart?
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Occasion {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id Int @id @default(autoincrement())

  name     String
  imageUrl String

  items ProductItem[]

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  occasion   Occasion @relation(fields: [occasionId], references: [id])
  occasionId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductItem {
  id Int @id @default(autoincrement())

  price  Int
  weight Int? 

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  cartItems CartItem[]
  fillings  Filling[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Filling {
  id Int @id @default(autoincrement())

  name        String
  composition String
  imageUrl String  

  productItems ProductItem[]
  cartItems    CartItem[]

  createdAt DateTime @default(now())
}

model Cart {
  id Int @id @default(autoincrement())

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  items CartItem[]

  token String
  totalAmount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id Int @id @default(autoincrement())

  cart      Cart @relation(fields: [cartId], references: [id])
  cartId    Int

  productItem   ProductItem @relation(fields: [productItemId], references: [id])
  productItemId Int

  quantity Int

  fillingId Int?
  filling   Filling? @relation(fields: [fillingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id Int @id @default(autoincrement())

  user   User? @relation(fields: [userId], references: [id])
  userId Int?

  token String

  totalAmount Int
   deliveryPrice Int? 
  status      OrderStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CASH) 
  paymentId   String?

  items Json

  fullName     String 
  email        String
  phone        String
  address      String
  deliveryDate String?  
  deliveryTime String? 
  comment      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WheelSpin {
  id        Int      @id @default(autoincrement())
  userId    Int
  
  discount  Int  
  spunAt    DateTime @default(now())
  expiresAt DateTime 

  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  ASSEMBLING
  DELIVERING
  SUCCEEDED
  CANCELLED
}
enum PaymentMethod {  
  CASH    
  CARD    
}

enum UserRole {
  USER
  ADMIN
}